<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rental Agreement - <%- lease.property.title %></title>

<style>
/* =========================
   RESET & BASE
========================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Times New Roman", Georgia, serif;
  font-size: 14px;
  line-height: 1.8;
  color: #1f2937;
  background: #ffffff;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}

.container {
  max-width: 820px;
  margin: 0 auto;
  padding: 48px 56px;
}

/* =========================
   HEADER
========================= */
.header {
  text-align: center;
  margin-bottom: 48px;
  padding-bottom: 24px;
  border-bottom: 3px solid #111827;
}

.header-logo {
  font-size: 12px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #6b7280;
  margin-bottom: 12px;
}

.title {
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-bottom: 12px;
}

.agreement-id {
  display: inline-block;
  margin-top: 8px;
  padding: 6px 16px;
  border: 1px solid #111827;
  font-size: 12px;
  font-weight: 600;
}

/* =========================
   SECTIONS
========================= */
.section {
  margin-bottom: 36px;
  page-break-inside: avoid;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 14px;
  padding-bottom: 6px;
  border-bottom: 1px solid #9ca3af;
  display: flex;
  align-items: center;
  gap: 10px;
}

.section-number {
  border: 1px solid #111827;
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
}

.section p {
  margin-bottom: 14px;
  text-align: justify;
}

.section strong {
  font-weight: 700;
}

/* =========================
   INFO BOXES
========================= */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 20px;
}

.info-box {
  border: 1px solid #111827;
  padding: 18px;
}

.info-box-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.info-box-content {
  font-size: 14px;
}

/* =========================
   PROPERTY DETAILS
========================= */
.property-details {
  border: 1px solid #111827;
  padding: 22px;
  margin-top: 18px;
}

.property-details h3 {
  font-size: 15px;
  margin-bottom: 12px;
}

.property-specs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 14px;
  margin-top: 16px;
}

.spec-item {
  border: 1px solid #d1d5db;
  padding: 12px;
}

.spec-label {
  font-size: 11px;
  text-transform: uppercase;
  color: #6b7280;
}

.spec-value {
  font-size: 15px;
  font-weight: 700;
}

/* =========================
   LISTS
========================= */
ul {
  margin-left: 22px;
}

li {
  margin-bottom: 10px;
}

/* =========================
   HIGHLIGHTS & AMOUNTS
========================= */
.highlight {
  padding: 2px 6px;
  border-bottom: 2px solid #111827;
  font-weight: 600;
}

.amount,
.currency {
  font-weight: 700;
}

/* =========================
   SIGNATURES
========================= */
.date-signed {
  margin: 48px 0;
  text-align: center;
  font-weight: 700;
}

.signature-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  page-break-inside: avoid;
}

.signature-box {
  text-align: center;
  border: 1px solid #111827;
  padding: 28px 18px;
}

.signature-box p {
  font-weight: 700;
  margin-bottom: 18px;
  text-transform: uppercase;
}

.qr-code {
  width: 140px;
  height: 140px;
  margin: 0 auto 18px auto;
  border: 1px solid #111827;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-code img {
  max-width: 100%;
  max-height: 100%;
}

.signature-line {
  height: 80px;
  border-bottom: 2px solid #111827;
  margin: 0 auto 18px auto;
  max-width: 240px;
  position: relative;
}

.signature-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-style: italic;
  color: #6b7280;
}

.signature-name {
  font-weight: 700;
  margin-top: 14px;
}

.signature-date {
  font-size: 12px;
  color: #6b7280;
}

/* =========================
   FOOTER
========================= */
.footer {
  margin-top: 60px;
  padding-top: 18px;
  border-top: 1px solid #9ca3af;
  text-align: center;
  font-size: 12px;
  color: #6b7280;
}

.footer-logo {
  font-weight: 700;
  margin-bottom: 6px;
}

/* =========================
   PRINT
========================= */
@media print {
  body {
    font-size: 12px;
  }

  .container {
    padding: 40px;
  }

  .section,
  .signature-section {
    page-break-inside: avoid;
  }
}
</style>
</head>

<body>
<!-- BODY CONTENT UNCHANGED -->

<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="header-logo">Official Document</div>
            <div class="title">Residential Rental Agreement</div>
            <div class="agreement-id">Agreement No: <%- rentalAgreement.id || 'RA-' + Date.now().toString().slice(-6) %></div>
        </div>

        <!-- Parties Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">1</span>
                THE PARTIES
            </div>
            <p>This Rental Agreement ("Agreement") is entered into on <span class="highlight"><%- new Date(lease.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>, between:</p>
            
            <div class="info-grid">
                <div class="info-box">
                    <div class="info-box-title">THE LESSOR (Landlord)</div>
                    <div class="info-box-content">
                        <strong>Name:</strong> <%- lease.landlord.name || (lease.landlord.firstName + ' ' + lease.landlord.lastName) %><br>
                        <% if (lease.landlord.phone) { %><strong>Phone:</strong> <%- lease.landlord.phone %><br><% } %>
                        <strong>Email:</strong> <%- lease.landlord.email %>
                    </div>
                </div>
                
                <div class="info-box">
                    <div class="info-box-title">THE LESSEE (Tenant)</div>
                    <div class="info-box-content">
                        <strong>Name:</strong> <%- lease.tenant.name || (lease.tenant.firstName + ' ' + lease.tenant.lastName) %><br>
                        <% if (lease.tenant.phone) { %><strong>Phone:</strong> <%- lease.tenant.phone %><br><% } %>
                        <strong>Email:</strong> <%- lease.tenant.email %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Premises Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">2</span>
                THE PREMISES
            </div>
            
            <div class="property-details">
                <h3>Property Information</h3>
                <p><strong>Address:</strong> <span class="highlight"><%- lease.property.address %>, <%- lease.property.city %>, <%- lease.property.state %> <%- lease.property.zipCode %>, <%- lease.property.country %></span></p>
                
                <div class="property-specs">
                    <div class="spec-item">
                        <div class="spec-label">Property Type</div>
                        <div class="spec-value"><%- lease.property.propertyType.name %></div>
                    </div>
                    <div class="spec-item">
                        <div class="spec-label">Bedrooms</div>
                        <div class="spec-value"><%- lease.property.bedrooms %></div>
                    </div>
                    <div class="spec-item">
                        <div class="spec-label">Bathrooms</div>
                        <div class="spec-value"><%- lease.property.bathrooms %></div>
                    </div>
                    <% if (lease.property.areaSqm) { %>
                    <div class="spec-item">
                        <div class="spec-label">Area</div>
                        <div class="spec-value"><%- lease.property.areaSqm %> m²</div>
                    </div>
                    <% } %>
                    <div class="spec-item">
                        <div class="spec-label">Furnishing</div>
                        <div class="spec-value"><%- lease.property.furnished ? 'Furnished' : 'Unfurnished' %></div>
                    </div>
                </div>
                
                <% if (lease.property.amenities && lease.property.amenities.length > 0) { %>
                <h3 style="margin-top: 20px;">Included Amenities</h3>
                <div class="amenities-list">
                    <% lease.property.amenities.forEach(amenity => { %>
                    <div class="amenity-item">✓ <%- amenity.amenity.name %></div>
                    <% }); %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Term Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">3</span>
                LEASE TERM
            </div>
            <p><strong>Commencement Date:</strong> <span class="highlight"><%- new Date(lease.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span></p>
            <p><strong>Expiration Date:</strong> <span class="highlight"><%- new Date(lease.endDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span></p>
            <p>The lease term is for <strong>one (1) year</strong>. Any extension or renewal requires written agreement from both parties.</p>
        </div>

        <!-- Rent Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">4</span>
                MONTHLY RENT
            </div>
            <p><strong>Monthly Rent Amount:</strong> <span class="currency"><%- lease.currencyCode %></span> <span class="amount"><%- parseFloat(lease.rentAmount).toLocaleString() %></span></p>
            <p><strong>Payment Due Date:</strong> 1st day of each month</p>
            <p><strong>Late Fee:</strong> 15% of monthly rent if payment is more than 5 days late</p>
            
            <% if (lease.securityDeposit) { %>
            <p><strong>Security Deposit:</strong> <span class="currency"><%- lease.currencyCode %></span> <span class="amount"><%- parseFloat(lease.securityDeposit).toLocaleString() %></span></p>
            <% } %>
        </div>

        <!-- Utilities Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">5</span>
                UTILITIES
            </div>
            <p>THE LESSEE shall be responsible for all utility services including electricity, water, gas, internet, and other services during the lease term. THE LESSEE must transfer utility accounts into their name within 48 hours of occupancy.</p>
        </div>

        <!-- Use and Occupancy Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">6</span>
                USE AND OCCUPANCY
            </div>
            <ul>
                <li><strong>Residential Use Only:</strong> The premises shall be used exclusively as a private residence.</li>
                <li><strong>No Subletting:</strong> THE LESSEE cannot sublet or assign without written consent from THE LESSOR.</li>
                <li><strong>Compliance:</strong> THE LESSEE must comply with all laws, regulations, and community rules.</li>
                <li><strong>No Illegal Activities:</strong> No illegal activities are permitted on the premises.</li>
            </ul>
        </div>

        <!-- Maintenance Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">7</span>
                MAINTENANCE & REPAIRS
            </div>
            <p><strong>LESSOR's Obligations:</strong> THE LESSOR shall maintain structural components, major systems (plumbing, electrical, HVAC), and ensure the property remains habitable.</p>
            <p><strong>LESSEE's Obligations:</strong> THE LESSEE shall maintain cleanliness, perform minor maintenance (light bulbs, filters), and report issues promptly.</p>
        </div>

        <!-- Termination Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">8</span>
                TERMINATION
            </div>
            <p>Either party may terminate this Agreement with <strong>30 days written notice</strong>. For material breach, termination may occur with <strong>7 days notice</strong> after breach notification.</p>
            <p>Upon termination, THE LESSEE shall vacate, return all keys, and THE LESSOR shall return the security deposit (less lawful deductions) within the legally required timeframe.</p>
        </div>

        <!-- General Provisions Section -->
        <div class="section">
            <div class="section-title">
                <span class="section-number">9</span>
                GENERAL PROVISIONS
            </div>
            <ul>
                <li><strong>Entire Agreement:</strong> This document constitutes the complete agreement between parties.</li>
                <li><strong>Modifications:</strong> Changes must be made in writing and signed by both parties.</li>
                <li><strong>Governing Law:</strong> This agreement is governed by the laws of the jurisdiction where the property is located.</li>
                <li><strong>Binding Effect:</strong> This agreement binds all successors and assigns.</li>
            </ul>
        </div>

        <!-- Witness Clause -->
        <div class="date-signed">
            <strong>IN WITNESS WHEREOF</strong>, the parties have executed this Agreement on the date first written above.
        </div>

        <!-- Signatures -->
        <div class="signature-section">
            <div class="signature-box">
                <p>THE LESSOR (Landlord)</p>
                <% if (signatures && signatures.landlord && signatures.landlord.qrCode) { %>
                    <div class="qr-code">
                        <img src="<%= signatures.landlord.qrCode %>" alt="Landlord E-Signature" />
                    </div>
                <% } else { %>
                    <div class="signature-line">
                        <div class="signature-placeholder">E-Signature</div>
                    </div>
                <% } %>
                <div class="signature-name"><%- lease.landlord.name || (lease.landlord.firstName + ' ' + lease.landlord.lastName) %></div>
                <div class="signature-date"><% if (signatures && signatures.landlord && signatures.landlord.signDate) { %><%= signatures.landlord.signDate %><% } else { %>_______________<% } %></div>
            </div>

            <div class="signature-box">
                <p>THE LESSEE (Tenant)</p>
                <% if (signatures && signatures.tenant && signatures.tenant.qrCode) { %>
                    <div class="qr-code">
                        <img src="<%= signatures.tenant.qrCode %>" alt="Tenant E-Signature" />
                    </div>
                <% } else { %>
                    <div class="signature-line">
                        <div class="signature-placeholder">E-Signature</div>
                    </div>
                <% } %>
                <div class="signature-name"><%- lease.tenant.name || (lease.tenant.firstName + ' ' + lease.tenant.lastName) %></div>
                <div class="signature-date"><% if (signatures && signatures.tenant && signatures.tenant.signDate) { %><%= signatures.tenant.signDate %><% } else { %>_______________<% } %></div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-logo">RENTVERSE</div>
            <p>This is a legally binding document. Both parties should retain a copy for their records.</p>
            <p>Generated on <%- new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
        </div>
    </div>
</body>
</html>
