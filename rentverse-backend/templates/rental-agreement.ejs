<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rental Agreement - <%- lease.property.title %></title>
    <style>
        /* Reset */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        @page { margin: 40px 50px; size: A4; }

        /* Use system fonts for reliability in headless env */
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: #222222;
            background: #ffffff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .container { max-width: 800px; margin: 0 auto; }

        /* Header */
        .header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px 0; margin-bottom:18px; }
        .brand { display:flex; align-items:center; gap:12px; }
        .brand-logo { width:72px; height:72px; background:#fff; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; box-shadow:0 1px 2px rgba(0,0,0,0.08); overflow:hidden; }
        .brand-logo img { width:100%; height:100%; object-fit:contain; }
        .brand-title { font-size:20px; font-weight:800; color:#0f172a; letter-spacing:1px; }
        .brand-sub { font-size:10px; color:#6b7280; text-transform:uppercase; letter-spacing:1px; }

        /* Watermark */
        .watermark { position:fixed; top:40%; left:50%; transform:translate(-50%,-50%) rotate(-30deg); font-size:80px; color:#0b10203b; opacity:0.06; pointer-events:none; white-space:nowrap; }

        /* Document info */
        .meta { background:#f8fafc; border:1px solid #e6eef6; padding:14px; border-radius:6px; margin-bottom:18px; display:flex; justify-content:space-between; gap:12px; }
        .meta .left, .meta .right { display:flex; flex-direction:column; gap:6px; }
        .meta-label { font-size:9px; text-transform:uppercase; color:#6b7280; font-weight:700; letter-spacing:0.8px; }
        .meta-value { font-size:13px; font-weight:700; color:#111827; }

        /* Property image and summary */
        .property { display:flex; gap:18px; margin:18px 0; }
        .prop-image { width:220px; height:150px; border-radius:6px; overflow:hidden; background:#f3f4f6; border:1px solid #e5e7eb; }
        .prop-image img { width:100%; height:100%; object-fit:cover; }
        .prop-details { flex:1; display:flex; flex-direction:column; justify-content:space-between; }
        .prop-title { font-size:16px; font-weight:800; color:#0f172a; }
        .prop-address { font-size:11px; color:#6b7280; }

        /* Summary table */
        .summary-table { width:100%; border-collapse:collapse; margin-top:12px; }
        .summary-table th, .summary-table td { text-align:left; padding:10px; border-bottom:1px dashed #e6eef6; }
        .summary-table th { width:40%; font-size:11px; color:#374151; text-transform:uppercase; font-weight:700; }

        /* Sections */
        .section { margin-bottom:26px; page-break-inside:avoid; }
        .section h2 { font-size:14px; color:#0f172a; margin-bottom:10px; border-left:4px solid #047857; padding-left:10px; }
        .clause { font-size:11px; color:#374151; margin-bottom:8px; }

        /* Signature area */
        .signatures { display:flex; gap:24px; margin-top:24px; }
        .sign-block { flex:1; border:1px solid #e6eef6; padding:12px; border-radius:6px; text-align:center; }
        .sign-placeholder { height:80px; display:flex; align-items:center; justify-content:center; background:#ffffff; border-radius:4px; }
        .sign-name { margin-top:8px; font-weight:700; color:#0f172a; }
        .sign-role { font-size:11px; color:#6b7280; }

        /* Footer */
        .footer { position:fixed; left:50px; right:50px; bottom:20px; font-size:9px; color:#9ca3af; text-align:center; }
        .page-number { float:right; font-size:9px; color:#9ca3af; }

        /* Utility */
        .muted { color:#6b7280; }
    </style>
</head>

<body>
<div class="container">

    <div class="watermark">RENTVERSE</div>

    <div class="header">
        <div class="brand">
            <div class="brand-logo">
                <% if (lease.property.logoUrl) { %>
                    <img src="<%- lease.property.logoUrl %>" alt="logo">
                <% } else { %>
                    <div style="font-weight:800; color:#047857;">RV</div>
                <% } %>
            </div>
            <div>
                <div class="brand-title">RENTVERSE</div>
                <div class="brand-sub">Residential Rental Agreement</div>
            </div>
        </div>
        <div class="meta">
            <div class="left">
                <div class="meta-label">Agreement</div>
                <div class="meta-value">RA-<%- lease.id.slice(-8).toUpperCase() %></div>
            </div>
            <div class="right">
                <div class="meta-label">Generated</div>
                <div class="meta-value"><%- new Date().toLocaleDateString() %></div>
            </div>
        </div>
    </div>

    <div class="property">
        <div class="prop-image">
            <% if (lease.property.imageUrl) { %>
                <img src="<%- lease.property.imageUrl %>" alt="property">
            <% } else if (lease.property.images && lease.property.images.length) { %>
                <img src="<%- lease.property.images[0].url %>" alt="property">
            <% } else { %>
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#9ca3af">No image</div>
            <% } %>
        </div>
        <div class="prop-details">
            <div>
                <div class="prop-title"><%- lease.property.title %></div>
                <div class="prop-address"><%- lease.property.address %>, <%- lease.property.city %></div>
            </div>

            <table class="summary-table">
                <tr><th>Start Date</th><td><%- new Date(lease.startDate).toLocaleDateString() %></td></tr>
                <tr><th>End Date</th><td><%- new Date(lease.endDate).toLocaleDateString() %></td></tr>
                <tr><th>Monthly Rent</th><td>RM <%- lease.rentAmount.toFixed(2) %></td></tr>
                <tr><th>Security Deposit</th><td>RM <%- (lease.depositAmount || 0).toFixed(2) %></td></tr>
                <tr><th>Payment Terms</th><td><%- lease.paymentTerms || 'Monthly in advance' %></td></tr>
            </table>
        </div>
    </div>

    <div class="section">
        <h2>Parties</h2>
        <div class="clause"><strong>Landlord:</strong> <%- lease.landlord.name || (lease.landlord.firstName + ' ' + lease.landlord.lastName) %> — <span class="muted"><%- lease.landlord.email %></span></div>
        <div class="clause"><strong>Tenant:</strong> <%- lease.tenant.name || (lease.tenant.firstName + ' ' + lease.tenant.lastName) %> — <span class="muted"><%- lease.tenant.email %></span></div>
    </div>

    <div class="section">
        <h2>Agreement Summary</h2>
        <div class="clause">This agreement covers the terms and conditions for letting the property described above, commencing on <strong><%- new Date(lease.startDate).toLocaleDateString() %></strong> and ending on <strong><%- new Date(lease.endDate).toLocaleDateString() %></strong>. Both parties agree to the payment terms and obligations set out below.</div>

        <!-- Placeholder for more detailed clauses. Keep concise for printed PDF. -->
        <% if (lease.clauses && lease.clauses.length) { %>
            <% lease.clauses.forEach(function(c, idx){ %>
                <div class="clause"><strong><%= idx + 1 %>.</strong> <%- c %></div>
            <% }) %>
        <% } else { %>
            <div class="clause">1. Tenant shall pay rent on time each month.</div>
            <div class="clause">2. Tenant shall keep the property in good condition.</div>
            <div class="clause">3. Security deposit will be held per the local regulations.</div>
        <% } %>
    </div>

    <div class="section">
        <h2>Signatures</h2>
        <div class="signatures">
            <div class="sign-block">
                <div class="sign-placeholder">
                    <% if (signatures && signatures.landlord && signatures.landlord.qrCode) { %>
                        <img src="<%- signatures.landlord.qrCode %>" alt="landlord-sign" style="max-height:100%; max-width:100%;" />
                    <% } else { %>
                        Signature
                    <% } %>
                </div>
                <div class="sign-name"><%- (lease.landlord.name || (lease.landlord.firstName + ' ' + lease.landlord.lastName)) %></div>
                <div class="sign-role">Landlord — <span class="muted"><%- signatures.landlord.signDate %></span></div>
            </div>

            <div class="sign-block">
                <div class="sign-placeholder">
                    <% if (signatures && signatures.tenant && signatures.tenant.qrCode) { %>
                        <img src="<%- signatures.tenant.qrCode %>" alt="tenant-sign" style="max-height:100%; max-width:100%;" />
                    <% } else { %>
                        Signature
                    <% } %>
                </div>
                <div class="sign-name"><%- (lease.tenant.name || (lease.tenant.firstName + ' ' + lease.tenant.lastName)) %></div>
                <div class="sign-role">Tenant — <span class="muted"><%- signatures.tenant.signDate %></span></div>
            </div>
        </div>
    </div>

    <div class="footer">
        <span>Generated by Rentverse • This is a system generated document</span>
        <span class="page-number">Page <span class="page"></span></span>
    </div>

</div>

<script>
    // Add page numbers if the browser supports CSS counters in PDF.
    (function(){
        try {
            var els = document.querySelectorAll('.page');
            for(var i=0;i<els.length;i++){
                els[i].textContent = (i+1);
            }
        } catch(e) {}
    })();
</script>

</body>
</html>
